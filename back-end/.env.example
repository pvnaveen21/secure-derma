# Render production template
# Root Directory: back-end
# Build Command: pip install -r requirements.txt
# Start Command: gunicorn config.wsgi:application --bind 0.0.0.0:$PORT$PORT

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-service.onrender.com

# Add the backend origin and any browser clients that call it directly.
CORS_ALLOWED_ORIGINS=https://secure-derma-admin.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com,https://secure-derma-admin.vercel.app
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Preferred on Render: use DATABASE_URL from your Render Postgres service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_CONN_MAX_AGE=600

JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_CLIENT_ID=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Secure Derma
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
OTP_EMAIL_FROM=
OTP_EMAIL_FROM_NAME=Secure Derma
OTP_EMAIL_SUBJECT=Secure Derma login verification code
ORDER_EMAIL_FROM=
ORDER_EMAIL_FROM_NAME=Secure Derma
ORDER_EMAIL_SUBJECT=

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_URL=https://api.msg91.com/api/v5/otp
MSG91_OTP_EXPIRY_SECONDS=600
MSG91_TIMEOUT_SECONDS=10
OTP_EXPIRY_SECONDS=600

WAREHOUSE_PINCODE=638301
WAREHOUSE_LATITUDE=11.3410
WAREHOUSE_LONGITUDE=77.7172
PINCODE_PROVIDER_TIMEOUT_SECONDS=8
PINCODE_GEOCODER_USER_AGENT=secure-derma-pincode-checker/1.0
PINCODE_DIRECTORY_CSV=/opt/render/project/src/back-end/secure_derma/data/india_pincodes.csv

# Local development alternative if DATABASE_URL is not used:
# DB_NAME=securederma
# DB_USER=securederma_user
# DB_PASSWORD=securederma_pass
# DB_HOST=localhost
# DB_PORT=5433
